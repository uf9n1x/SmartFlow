# ========== 数据库配置（Docker 部署用）==========
# Docker 自动创建 MySQL 容器，以下变量用于设定 root 密码和数据库名
# 手动部署不需要这两个变量 — 请直接修改下方 DATABASE_URL 的连接信息
MYSQL_ROOT_PASSWORD=password       # Docker MySQL root 密码，生产环境务必修改
MYSQL_DATABASE=people_counting     # Docker 自动创建的数据库名

# ========== 数据库配置（手动部署用）==========
# 手动部署时修改下面这行的用户名、密码、主机和端口
# Docker 部署时后端容器会自动用上面的 MYSQL_ROOT_PASSWORD + MYSQL_DATABASE 构造此 URL
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/people_counting

# ========== Redis 配置 ==========
# Docker 部署时容器内通过服务名 redis 访问，无需修改
# 手动部署时改为实际 Redis 地址
REDIS_URL=redis://localhost:6379/0

# ========== JWT 配置 ==========
# 生产环境务必修改 SECRET_KEY 为随机长字符串
SECRET_KEY=change-me-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ========== 业务配置 ==========
MAX_PEOPLE=500              # 默认最大人数上限（可在后台管理页面动态调整）
RATE_LIMIT_SECONDS=10       # 游客提交频率限制间隔（秒）
MAX_VISITOR_COUNT=10        # 游客单次登记最大人数
MAX_STAFF_COUNT=50          # 工作人员单次登记最大人数

# ========== 默认管理员账号（仅首次启动自动创建时生效）==========
# 如果数据库中已有管理员账号，这两个配置不生效
# 生产环境务必修改为安全口令！
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
